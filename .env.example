# Core runtime
PORT=8787
CLAWFIRM_ADAPTER_TOKEN=replace-with-strong-random-secret
CLAWFIRM_AUTH_DOMAIN=box.example.com
CLAWFIRM_SITES_ROOT=/srv/clawfirm-box/sites

# DNS mode: local or ssh
CLAWFIRM_DNS_MODE=local

# Local DNS helpers
CLAWFIRM_DNS_READ_COMMAND=/usr/local/bin/clawfirm-dns-read
CLAWFIRM_DNS_APPLY_COMMAND=/usr/local/bin/clawfirm-dns-apply

# SSH DNS mode, only needed when CLAWFIRM_DNS_MODE=ssh
# CLAWFIRM_DNS_SSH_HOST=
# CLAWFIRM_DNS_SSH_USER=
# CLAWFIRM_DNS_SSH_PORT=22
# CLAWFIRM_DNS_SSH_KEY_PATH=/home/clawfirm/.ssh/dns_adapter

# Caddy integration
CLAWFIRM_CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
CLAWFIRM_CADDY_SNIPPETS_DIR=/etc/caddy/sites-enabled
CLAWFIRM_CADDY_SERVICE_NAME=caddy
CLAWFIRM_CADDY_RELOAD_COMMAND=systemctl reload caddy
CLAWFIRM_CADDY_MANAGED_HOST_EXCLUDE=box.example.com
CLAWFIRM_CADDY_HTTP_ONLY=false

# Serving / defaults
CLAWFIRM_ACCESS_LOG_PATH=/var/log/caddy/access.log
CLAWFIRM_DNS_DEFAULT_A=127.0.0.1
# CLAWFIRM_DNS_DEFAULT_AAAA=
CLAWFIRM_NO_WWW_HOST_SUFFIXES=dev.example.internal
